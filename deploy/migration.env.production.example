# One-shot migration identity. Keep this file separate from the runtime env
# file: web and workers must never receive schema-owning credentials.
NODE_ENV=production
DEPLOYMENT_PROFILE=production
# Owns schema rwa (DDL, triggers). Used only by `docker compose run --rm migrate`.
MIGRATION_DATABASE_URL=postgresql://rwa_migrator:REPLACE_ME@postgres.example:5432/rwa_control_plane?sslmode=verify-full
# Receives SELECT/INSERT/UPDATE only (no DELETE, TRUNCATE, TRIGGER or DDL).
# Must match the user in the runtime DATABASE_URL.
RUNTIME_DATABASE_ROLE=rwa_runtime
