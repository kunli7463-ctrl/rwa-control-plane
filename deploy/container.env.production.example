# This is a contract for secret/config injection by the deployment platform.
# Never commit populated values and never use the local development key in production.
NODE_ENV=production
DEPLOYMENT_PROFILE=production
TENANT_ID=REPLACE_WITH_DEPLOYMENT_TENANT
HOST=0.0.0.0
PORT=8765

STORAGE_MODE=postgres
DATABASE_URL=postgresql://rwa_runtime:REPLACE_ME@postgres.example:5432/rwa_control_plane?sslmode=verify-full

AUTH_MODE=oidc
PUBLIC_ORIGIN=https://rwa.example.com
COOKIE_SECURE=true

ENVELOPE_CIPHER_MODE=kms
KMS_PROVIDER_MODULE=/run/rwa/providers/kms-provider.js
KMS_KEY_ID=REPLACE_WITH_KMS_KEY_RESOURCE_OR_ALIAS
ECONOMIC_COMMITMENT_KMS_KEY_ID=REPLACE_WITH_KMS_HMAC_KEY_RESOURCE_OR_ALIAS
ALLOW_LOCAL_DEV_KEY=false

ZK_MODE=groth16
ZK_ARTIFACT_DIR=/run/rwa/zk-artifacts
ZK_ARTIFACT_MANIFEST_SHA256=REPLACE_WITH_LOWERCASE_64_HEX_PIN

PROVER_MODE=isolated
PROVER_ENDPOINT=https://prover.internal.example
PROVER_SERVICE_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
PROVER_EXPECTED_SERVICE_ID=REPLACE_WITH_PINNED_SERVICE_ID
PROVER_TENANT_ID=REPLACE_WITH_DEPLOYMENT_TENANT
PROVER_HEALTH_HOST=0.0.0.0
PROVER_HEALTH_PORT=8771
PROVER_WORKER_POLL_MS=1000

OUTBOX_TENANT_ID=REPLACE_WITH_DEPLOYMENT_TENANT
OUTBOX_PUBLISHER_MODULE=/run/rwa/providers/outbox-publisher.js
