    {
      "id": 13,
      "type": "text",
      "title": "Operational boundary",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Missing data is UNKNOWN, never healthy. This dashboard is operator-only; labels and filters do not enforce tenant isolation. No balances, owners, amounts, proof contents or witness values are collected. Alert notification routing requires separate deployment acceptance."
      }
