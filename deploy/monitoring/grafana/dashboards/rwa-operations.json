{
  "uid": "rwa-operations",
  "title": "RWA Worker Operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "rwa",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "OUTBOX — Scrape availability",
      "datasource": {
        "type": "prometheus",
        "uid": "rwa-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rwa-outbox\"}",
          "legendFormat": "{{tenant}} / {{environment}} / {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "OUTBOX — Worker ready",
      "datasource": {
        "type": "prometheus",
        "uid": "rwa-prometheus"
